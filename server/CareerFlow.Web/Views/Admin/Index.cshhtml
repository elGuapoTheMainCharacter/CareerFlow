@model CareerFlow.Web.Models.AdminDashboardViewModel
@{ ViewData["Title"] = "CareerFlow Admin"; }
<div class="container py-5">
 <h1>CareerFlow Admin</h1>
 <p class="text-muted">Server-rendered ASP.NET Core MVC view.</p>
 <div class="row g-3">
 <div class="col"><div class="card card-body"><b>Users</b><span>@Model.Users</span></div></div>
 <div class="col"><div class="card card-body"><b>Companies</b><span>@Model.Companies</span></div></div>
 <div class="col"><div class="card card-body"><b>Opportunities</b><span>@Model.Opportunities</span></div></div>
 <div class="col"><div class="card card-body"><b>Applications</b><span>@Model.Applications</span></div></div>
 </div>
</div>